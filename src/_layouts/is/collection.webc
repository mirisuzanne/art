---
layout: is/page
---

<script webc:setup>
  export const getCollection = (data) => {
    if (!data.list) return;

    if (typeof data.list === 'string') {
      if (!data.collections[data.list]) return;
      return sortByStock(data.collections[data.list]);
    }

    return data.collections.product.filter(
      (item) => data.list.includes(item.page.url)
    );
  }
</script>

<header>
  <h1 @html="mdInline(this.title)"></h1>
  <sub-title webc:if="this.sub" @html="mdInline(this.sub)"></sub-title>
</header>

<div webc:if="this.summary" @html="mdBlock(this.summary)"></div>

<section
  webc:if="this.content"
  @raw="this.content"
></section>

<toggle-control
  webc:if="typeof this.list === string"
  data-for="#product-list"
  data-attr="data-show"
>
  <button data-value="all" aria-pressed="true">show all</button>
  <button data-value="stock">in stock</button>
  <button data-value="demand">on demand</button>
</toggle-control>

<nav
  webc:if="getCollection($data)"
  :grid-container="getCollection($data).length > 5 ? 'wide' : 'pull'"
  id="product-list"
>
  <media-gallery>
    <gallery-item
      webc:for="(item, index) of getCollection($data)"
      product-card
      :data-stock="inStock(item.data)
        ? 'true'
        : (reStock(item.data) ? 'demand' : 'false')"
    >
      <a
        product-title
        :href="item.url"
      ><span @text="item.data.title"></span></a>
      <product-flag
        webc:if="reStock(item.data)"
      >made to order</product-flag>
      <product-flag
        webc:elseif="!inStock(item.data)"
      >sold</product-flag>
      <product-flag
        webc:elseif="item.data.flag"
        @text="item.data.flag"
      ></product-flag>
      <product-image
        :@item="item.data.gallery?.find((item) => item.image)"
        :@url="item.url"
        :@first="this.index === 0"
      ></product-image>
    </gallery-item>
  </media-gallery>
</nav>

<style webc:bucket="page">
  @layer layout {
    [product-card] {
      display: grid;
      grid-template:
        'image flag' auto
        'title title' auto
        / 1fr auto
      ;
    }

    [product-image] {
      grid-area: image;
      grid-column-end: -1;
    }

    [product-title] {
      display: grid;
      grid-area: 1 / 1 / -1 / -1;
      grid-template-columns: subgrid;
      grid-template-rows: subgrid;
      z-index: 1;

      span {
        grid-area: title;
      }
    }

    product-flag {
      align-self: start;
      background: var(--feature-gradient);
      border: medium solid;
      color: var(--background-color);
      font-weight: bold;
      font-variant-caps: all-small-caps;
      grid-area: flag;
      line-height: 1;
      margin: var(--shim);
      padding: 0.25lh var(--shim);
      text-transform: lowercase;
      z-index: 1;
    }

    [data-show=stock] {
      gallery-item:not([data-stock=true]) { display: none; }
    }

    [data-show=demand] {
      gallery-item:not([data-stock=demand]) { display: none; }
    }
  }
</style>
