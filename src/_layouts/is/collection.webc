---
layout: is/page
---

<header>
  <h1 @text="this.title"></h1>
  <sub-title webc:if="this.sub" @html="this.sub"></sub-title>
</header>

<nav>
  <art-gallery webc:if="this.collections[this.list]?.length > 0">
    <gallery-item data-card webc:for="(item, index) of this.collections[this.list].toReversed()">
      <a
        card-link
        :href="item.url"
        @text="item.data.title"
      ></a>
      <em webc:if="item.data.stock === 0">&ndash; SOLD</em>
      <nav-img
        :@item="item.data.gallery?.find((item) => item.image)"
        :@url="item.url"
        :@first="this.index === 0"
      ></nav-img>
    </gallery-item>
  </art-gallery>
</nav>

<section
  webc:if="this.content"
  @raw="this.content"
></section>
