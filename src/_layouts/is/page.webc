---
layout: base
css:
  - fonts
  - page
nav:
  pricing: '/pricing/'
  commission: '/commission/'
  about: '/about/'
---

<!-- <shop-keep></shop-keep> -->

<header id="banner">
  <a href="/" rel="home">m</a>
  <nav id="main-nav" webc:if="this.nav">
    <a
      webc:for="(name, url) in this.nav"
      :href="url"
      @text="name"
    ></a>
  </nav>
  <pop-over
    data-for="color-control"
    show-when="js"
  >
    <button popovertarget="color-controls">colors</button>
    <dialog id="color-controls" popover>
      <color-control></color-control>
    </dialog>
  </pop-over>
</header>

<main id="main" data-prose @raw="this.content"></main>

<!---- <a href="#cart" id="cart-link" hidden>
  Cart <shop-output data-stat="count" hide-zero></shop-output>
</a>

<aside shopping-cart>
  <shopping-cart
    show-when="defined"
    id="cart"
  ></shopping-cart>

  <noscript>
    <p>
      The shopping cart requires Javascript,
      but you can always email me instead:
      <a href="mailto:miriam@miriamsuzanne.com">miriam@miriamsuzanne.com</a>
    </p>
  </noscript>
</aside>

<shipping-rates
  show-when="defined"
  data-from="80205"
  data-global="true"
  hidden
></shipping-rates> ---->

<check-out>
  <h2>See something you like?</h2>
  <p>
    If you send me a message,
    I'll get back to you
    about payment & shipping options --
    or any other questions you have.
  </p>
</check-out>

<link
  rel="stylesheet"
  href="../../_css/fonts.css"
  webc:bucket="fonts"
>

<style webc:bucket="page">
@property --grid-column {
  syntax: '*';
  inherits: false;
  initial-value: content;
}

body {
  --content-grid-columns:
    [full-start] minmax(var(--gap), 1fr)
    [pull-start] minmax(0, 1fr)
    [content-start] minmax(min-content, 60ch) [content-end]
    minmax(0, 1fr) [pull-end]
    minmax(var(--gap), 1fr) [full-end];
  display: grid;
  grid-template-columns: var(--content-grid-columns);
  margin: 1lh 0;

  & > * {
    grid-column: var(--grid-column, content);
  }
}

[shopping-cart] {
  --grid-column: full;
}

#banner {
  --name: banner;
  display: grid;
  gap: var(--shim);
  grid-template:
    'home colors' auto
    'nav nav' auto
    / 1fr auto
  ;

  @media (width > 45em) {
    --justify-nav: end;
    grid-template:
      'home nav colors' auto
      / auto 1fr auto
    ;
  }
}

[rel=home] {
  font-family: var(--fonts-serif);
  font-style: italic;
  grid-area: home;
}

#main-nav {
  display: flex;
  gap: var(--shim);
  grid-area: nav;
  justify-content: var(--justify-nav);
}

main {
  --grid-column: full;
  display: grid;
  grid-template-columns: var(--content-grid-columns);
  margin-block: var(--spacer) var(--gap);

  & > * {
    grid-column: var(--grid-column, content);
  }
}

sub-title {
  font-style: italic;

  time + &::before {
    content: ' – ';
  }
}

[show-when=defined]:not(:defined) { display: none !important; }
</style>
