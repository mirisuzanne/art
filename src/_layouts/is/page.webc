---
layout: base
css:
  - fonts
  - page
nav:
  requests: '/commission/'
  about: '/about/'
---

<shop-keep></shop-keep>
<site-banner></site-banner>
<main id="main" data-prose @raw="this.content"></main>

<footer id="contentinfo">
  <p>
    Copyright (c) <strong>Miriam Suzanne</strong>,
    <time @text="new Date().getFullYear()"></time>
  </p>
  <ul>
    <li webc:for="link of this.social">
      <a :href="link.url" rel="me" @text="link.name"></a>
      on <strong @text="link.on"></strong>
    </li>
    <li>
      <a href="https://buttondown.com/MiaCulpa">
        Mia Culpa
      </a>
      in <strong>Your Inbox</strong>
    </li>
  </ul>
</footer>

<link
  rel="stylesheet"
  href="../../_css/fonts.css"
  webc:bucket="fonts"
>

<style webc:bucket="page">
@property --grid-column {
  syntax: '*';
  inherits: false;
  initial-value: content;
}

@layer layout {
  body {
    --content-grid-columns:
      [full-start] var(--gap)
      [wide-start] minmax(0, 1fr)
      [pull-start] minmax(0, var(--pull, 1fr))
      [content-start] minmax(min-content, 60ch) [content-end]
      minmax(0, var(--pull, 1fr)) [pull-end]
      minmax(0, 1fr) [wide-end]
      var(--gap) [full-end];
    align-items: start;
    box-sizing: border-box;
    display: grid;
    row-gap: var(--spacer);
    grid-template-columns: var(--content-grid-columns);
    grid-template-rows: auto 1fr;
    padding: 1lh 0;
    min-block-size: 100%;

    @media (width > 50em) {
      --pull: 8ch;
    }

    & > * {
      grid-column: var(--grid-column, content);
    }
  }

  main {
    --grid-column: full;
    display: grid;
    grid-template-columns: var(--content-grid-columns);

    & > * {
      grid-column: var(--grid-column, content);
    }
  }

  sub-title {
    font-style: italic;

    time + &::before {
      content: ' – ';
    }
  }

  [show-when=defined]:not(:defined) { display: none !important; }

  [grid-container] {
    container: layout / inline-size;
  }

  [grid-container~=pull] {
    --grid-column: pull;
  }

  [grid-container~=wide] {
    --grid-column: wide;
  }

  [grid-container~=full] {
    --grid-column: full;
  }

  [shopping-cart] {
    --grid-column: full;
  }

  #contentinfo {
    --grid-column: full;
    border-block-start: thin solid var(--border-color);
    border-image: var(--feature-gradient) 1;
    padding: var(--gap);
  }
}

</style>
