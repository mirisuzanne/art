<hr>

<check-out>
  <h2>See something you like?</h2>
  <p>
    I'm still working on
    a checkout system,
    but if you send me a message,
    I'll get back to you
    about payment & shipping options.
  </p>
</check-out>

<link
  rel="stylesheet"
  href="../../_css/fonts.css"
  webc:bucket="fonts"
>

<style webc:bucket="page">
@property --grid-column {
  syntax: '*';
  inherits: false;
  initial-value: content;
}

body {
  --content-grid-columns:
    [full-start] 1fr
    [content-start] minmax(min-content, 60ch) [content-end]
    1fr [full-end];
  display: grid;
  grid-template-columns: var(--content-grid-columns);
  margin: 1lh 0;

  & > * {
    grid-column: var(--grid-column, content);
  }
}

[shopping-cart] {
  --grid-column: full;
}

#banner {
  display: flex;
  justify-content: space-between;
}

main {
  --grid-column: full;
  display: grid;
  grid-template-columns: var(--content-grid-columns);
  margin-block: var(--spacer) var(--gap);

  & > * {
    grid-column: var(--grid-column, content);
  }
}

sub-title {
  font-style: italic;

  time + &::before {
    content: ' – ';
  }
}

[show-when=defined]:not(:defined) { display: none !important; }
</style>
