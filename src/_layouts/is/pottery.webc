---
layout: is/product
tags:
  - pottery
---

<figure webc:if="this.gallery?.length > 0">
  <art-gallery>
    <gallery-item
      webc:for="(item, index) of this.gallery"
      :@item="item"
      :@first="index === 0"
    ></gallery-item>
  </art-gallery>
</figure>

<div @raw="this.content"></div>

<p>
  Made by hand in Denver,
  using <em @text="this.clay"></em>
  from <em @text="this.from"></em>.
  <span webc:if="this.safe === 'yes'">
    Food safe, microwave safe, and dishwasher safe.
  </span>
  <span webc:elseif="this.safe" @text="this.safe"></span>
</p>
