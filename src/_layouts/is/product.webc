---
layout: is/page
tags:
  - product
---

<header>
  <h1 @html="mdInline(this.title)"></h1>
  <sub-title webc:if="this.sub" @html="mdInline(this.sub)"></sub-title>

  <div>
    <span webc:if="inStock($data)">
      <time
        :datetime="this.page.date.toISOString()"
        @text="dateFormat(this.page.date)"
      ></time>
      –
    </span>
    <em webc:if="reStock($data)">Made to order</em>
    <em
      webc:elseif="inStock($data)"
      @text="`${this.stock} in stock`"
    ></em>
    <em webc:else>Sold</em>
  </div>
</header>

<div webc:if="this.summary" @html="mdBlock(this.summary)"></div>

<figure grid-container="pull" webc:if="this.gallery?.length > 0">
  <media-gallery>
    <gallery-item
      webc:for="(item, index) of this.gallery"
      :@item="item"
      :@first="index === 0"
    ></gallery-item>
  </media-gallery>
</figure>

<div webc:nokeep @raw="this.content"></div>

<product-details webc:if="showStock($data) && (this.size || this.lb || this.price)">
  <strong>Details…</strong>
  <dl>
    <div webc:if="this.size">
      <dt>size</dt>
      <dd @text="`${sizeToString(this.size)} inches`"></dd>
    </div>
    <div webc:if="this.lb">
      <dt>weight</dt>
      <dd @text="`${this.lb}lb`"></dd>
    </div>
    <div webc:if="this.price">
      <dt><a href="/pricing/">suggested price</a></dt>
      <dd>
        $<span @text="this.price"></span>
        <span webc:if="this.set">for the set</span>
        <span webc:elseif="this.stock > 1">each</span>
      </dd>
    </div>
  </dl>

  <!-- <add-to-cart
    :data-title="this.title"
    :data-url="this.page.url"
    :data-weight="this.lb"
    :data-size="paddedSize(this.size, this.padding)"
    :data-price="this.price"
    show-when="defined"
  ></add-to-cart> -->
</product-details>

<tag-list></tag-list>

<style webc:bucket="page">
@layer layout {
  product-details {
    background: var(--callout-color);
    display: grid;
    gap: var(--shim);
    grid-template-columns: var(--shim) 1fr var(--shim);
    padding-block-end: var(--shim);

    & > * {
      margin-block: unset;
      grid-column: 2;
    }

    strong {
      background: var(--feature-gradient);
      color: var(--background-color);
      grid-column: 1 / -1;
      padding: calc(var(--shim) / 2) var(--shim);
    }

    dt, dd { display: inline; }

    dt {
      font-weight: bold;

      &::after { content: ': '; }
    }

    dd { margin: unset; }
  }
}
</style>
