---
layout: is/page
tags:
  - product
---

<header>
  <h1 @html="mdInline(this.title)"></h1>
  <sub-title webc:if="this.sub" @html="mdInline(this.sub)"></sub-title>
</header>

<product-details>
  <dl>
    <div>
      <dt>stock</dt>
      <dd webc:if="reStock($data)">made to order</dd>
      <dd
        webc:elseif="inStock($data)"
        @text="`${this.stock} in stock`"
      ></dd>
      <dd webc:else><strong>Sold</strong></dd>
    </div>
    <div webc:if="sizeToString(this.size)">
      <dt>size</dt>
      <dd @text="`${sizeToString(this.size)} inches`"></dd>
    </div>
    <div webc:if="this.lb">
      <dt>weight</dt>
      <dd @text="`${this.lb}lb`"></dd>
    </div>
    <div webc:if="this.price && this.showStock($data)">
      <dt><a href="/pricing/">suggested price</a></dt>
      <dd>
        $<span @text="this.price"></span>
        <span
          webc:if="this.set"
          @text="`for a set of ${this.set}`"
        ></span>
        <span webc:elseif="this.stock > 1 || this.restock">each</span>
      </dd>
    </div>
  </dl>

  <add-to-cart
    webc:if="showStock($data)"
    show-when="defined"
    :data-title="this.title"
    :data-url="this.page.url"
    :data-weight="this.lb || 2"
    :data-size="paddedSize(this.size, this.padding)"
    :data-price="this.set ? this.price / this.set : this.price"
    :data-stock="this.stock || 50"
    :data-count="this.set || 1"
  ></add-to-cart>
</product-details>

<div webc:if="this.summary" @html="mdBlock(this.summary)"></div>

<figure grid-container="pull" webc:if="this.gallery?.length > 0">
  <media-gallery>
    <gallery-item
      webc:for="(item, index) of this.gallery"
      :@item="item"
      :@first="index === 0"
      @attributes="({
        'data-option': item.option
      })"
    ></gallery-item>
  </media-gallery>
</figure>

<div webc:nokeep @raw="this.content"></div>

<tag-list></tag-list>

<style webc:bucket="page">
@layer layout {
  [data-option] {
    display: grid;

    * { grid-area: 1 / 1; }

    &::after {
      background: var(--callout-color);
      border-radius: 3px;
      content: '#' attr(data-option);
      grid-area: 1 / 1;
      margin: var(--shim);
      padding-inline: 1ch;
      place-self: end;
      z-index: 2;
    }
  }

  product-details {
    background: var(--callout-color);
    display: grid;
    gap: var(--gap);
    padding: var(--gap);

    & > * {
      margin-block: unset;
    }

    dt, dd { display: inline; }

    dt {
      font-weight: bold;

      &::after { content: ': '; }
    }

    dd { margin: unset; }
  }

  purchase-item {
    display: flex;
    gap: 1ch;
  }
}
</style>
