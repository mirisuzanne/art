<style>
:is(figure, nav):has(art-gallery) {
  --grid-column: full;
  container: gallery / inline-size;
  margin: var(--gap);
}

art-gallery {
  display: grid;
  gap: var(--gap);

  @container gallery (inline-size > 40ch) {
    grid-template-columns: repeat(2, 1fr);

    & > :first-child,
    & > :last-child:nth-child(even) {
      --span: span 2;
    }
  }

  img {
    border: thin solid var(--feature-color);
  }
}

gallery-item,
[gallery-item] {
  grid-column: var(--span, initial);
}
</style>
