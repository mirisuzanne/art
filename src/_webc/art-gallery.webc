<style>
:is(figure, nav):has(> art-gallery) {
  --grid-column: pull;
  container: gallery / inline-size;
}

art-gallery {
  display: grid;
  gap: var(--gap);

  @container gallery (inline-size > 40ch) {
    grid-template-columns: repeat(2, 1fr);

    & > :first-child:nth-last-child(n+3),
    & > :last-child:nth-child(2n+4) {
      --span: span 2;
    }
  }

  img {
    border: thin solid var(--feature-color);
    border-image: var(--feature-gradient) 1;
  }
}

gallery-item,
[gallery-item] {
  grid-column: var(--span, initial);
}
</style>
