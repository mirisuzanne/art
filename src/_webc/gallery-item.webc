<img
  webc:if="this.item.image"
  :src="this.item.image"
  :alt="this.item.alt || ''"
  :style="`--name: ${slugify(this.item.image)}`"
  @attributes="({
    loading: this.first ? 'eager' : 'lazy',
    decoding: this.first ? 'auto' : 'async',
    sizes: this.first ? '100w' : 'auto',
  })"
>
<video
  webc:elseif="this.item.video"
  :src="this.item.video"
  :alt="this.item.alt || ''"
  :type="this.item.type || 'video/mp4'"
  :width="this.item.width || 1920 "
  :height="this.item.height || 1080"
  controls
  muted
  @attributes="({
    loop: this.item.loop,
  })"
></video>
<lite-youtube
  webc:elseif="this.item.youtube"
  :videoid="this.item.youtube"
  :style="`background-image: url('https://v1.opengraph.11ty.dev/https%3A%2F%2Fyoutube.com%2Fwatch%3Fv%3D${this.item.youtube}/auto/jpeg/');`"
  @text="this.item.alt || ''"
></lite-youtube>

<style webc:bucket="page">
  @layer starter.reset {
    gallery-item { display: block; }
  }
</style>
