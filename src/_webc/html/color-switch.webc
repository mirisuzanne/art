<button>
	<fa-sun></fa-sun>
	<fa-moon></fa-moon>
	<visually-hidden>light/dark</visually-hidden>
</button>

<style webc:bucket="page">
@layer page {
	color-switch {
		button {
			align-items: center;
			display: grid;
			gap: 0.2ch;
			grid-template: 'icon';
			overflow: clip;
		}

		[data-icon] {
			display: none;
			block-size: 1lh;
			grid-area: icon;
			opacity: 0;
			transition: all 300ms ease-out;
			transform:
				rotate(calc(45deg * var(--right, -1)))
				translate(calc(200% * var(--right, -1)))
			;
		}

		[data-icon=moon] { --right: 1; }

		&[data-scheme] [data-icon] { display: block; }
		&[data-scheme=light] [data-icon=sun],
		&[data-scheme=dark] [data-icon=moon] {
			opacity: 1;
			transform: rotate(0deg) translate(0px);
		}
	}
}
</style>

<script>
class ColorSwitch extends HTMLElement {
	static register(tagName) {
		if ('customElements' in window) {
			customElements.define(tagName || 'color-switch', ColorSwitch);
		}
	};

	toggle;
	meta;

	#darkModePref;

	get storage() {
		return localStorage.getItem('color-scheme');
	}

	get preference() {
		return this.#darkModePref?.matches
			? 'dark'
			: 'light';
	}

	get scheme() {
		const value = this.meta.getAttribute('content');

		return value.includes(' ')
			? this.preference
			: value;
	}

	set scheme(mode) {
		localStorage.setItem('color-scheme', mode);
		this.meta.setAttribute('content', mode);
		this.setToggleState();
	};

	connectedCallback() {
		this.#darkModePref = window.matchMedia("(prefers-color-scheme: dark)");

    this.#findToggle();
    this.#findMeta();
		this.#addListeners();

		if (this.storage) {
			this.scheme = this.storage;
		} else {
			this.setToggleState();
		}
  };

  disconnectedCallback() {
    this.#removeListeners();
  };

	doToggle = () => {
		this.scheme = this.scheme === 'light'
			? 'dark'
			: 'light';
	}

	setToggleState = () => {
		const pressed = this.scheme != this.preference;
		this.dataset.scheme = this.scheme;
		this.toggle?.setAttribute('aria-pressed', pressed);
	}

	#findToggle = () => {
		this.toggle = this.querySelector('button');
		this.toggle?.setAttribute('type', 'button');
	}

	#findMeta = () => {
		this.meta = document.querySelector('meta[name=color-scheme]');
	}

	#addListeners = () => {
		this.toggle?.addEventListener('click', (e) => this.doToggle());
		this.#darkModePref?.addEventListener('change', (e) => this.setToggleState());
	}

	#removeListeners = () => {
		this.toggle?.removeEventListener('click', (e) => this.doToggle());
		this.#darkModePref?.removeEventListener('change', (e) => this.setToggleState());
	}
}

ColorSwitch.register();
</script>
