<solar-eclipse-toggle>
  <button type="button">
    <span class="se-label-dark" hidden><svg aria-hidden="true" width="20" height="20"><use href="#se-icon-moon"/></svg>Use dark theme</span>
    <span class="se-label-light" hidden><svg aria-hidden="true" width="20" height="20"><use href="#se-icon-sun"/></svg>Use light theme</span>
    <span class="se-label-unknown"><svg aria-hidden="true"><use href="#se-icon-half"/></svg>Theme</span>
  </button>
</solar-eclipse-toggle>

