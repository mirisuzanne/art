<script webc:setup>
  export const tagLink = (tag, all) =>
    all.find((page) => page.data.list === tag)?.page.url;
</script>

<ul webc:if="$data.tags">
  <li
    webc:for="tag of $data.tags"
    webc:if="tagLink(tag, $data.collections.all)"
  >
    <a :href="tagLink(tag, $data.collections.all)" @text="tag"></a>
  </li>
</ul>
