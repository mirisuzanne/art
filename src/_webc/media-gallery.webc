<style webc:bucket="page">
@layer page {
  media-gallery {
    --column: minmax(min(100%, 400px), 1fr);
    display: grid;
    grid-auto-columns: var(--column);
    grid-template-columns: repeat(
      auto-fit,
      var(--column)
    );
    gap: var(--gap);
    margin-block: 1lh;

    figure & {
      --auto-span: span 2;
    }

    & > :only-child,
    & > :first-child:nth-last-child(n+3),
    & > :last-child:nth-child(2n+4) {
      --span: var(--auto-span);
    }

    @container (inline-size > 800px) {
      gallery-item,
      [gallery-item] {
        grid-column: var(--span, initial);
      }
    }

    img {
      aspect-ratio: var(--aspect, 3/2);
      border: thin solid var(--feature-color);
      border-image: var(--feature-gradient) 1;
      inline-size: stretch;
      object-fit: cover;
    }
  }
}
</style>
