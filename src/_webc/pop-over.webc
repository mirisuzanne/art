<style>
@layer tools {
  pop-over {
    &:has(:popover-open) {
      --popover-is-open: ;
    }
  }

  button[popovertarget] {
    background: transparent;
    border: thin solid currentColor;
    color: inherit;
    padding-inline: 1ch;
  }

  [popover] {
    border: thin solid;
    box-sizing: border-box;
    filter: drop-shadow(0 0 var(--shim) var(--shadow-color));
    margin-block: var(--shim);
    max-inline-size: min(100%, 45ch);
    overflow: visible;
    padding: var(--gap);
    position-area: var(--area, bottom span-left);
    position-try-fallbacks: flip-block, flip-inline;

    &::after {
      aspect-ratio: 16/9;
      background: currentColor;
      content: '';
      clip-path: polygon(0% 100%, 50% 0%, 100% 100%);
      inset: auto 1ch 100% auto;
      inline-size: 2ch;
      position: absolute;
    }
  }
}
</style>
