<button aria-pressed="false">Add to cart</button>
<cart-control
  hidden
  data-name="count"
  :data-item="this.dataUrl"
>
  In cart…
</cart-control>

<style webc:bucket="page">
  @layer tools {
    add-to-cart {
      display: flex;
      gap: 1ch;
    }
  }
</style>

<script>
class AddToCart extends HTMLElement {
	static register(tagName) {
		if ("customElements" in window) {
			customElements.define(tagName || "add-to-cart", AddToCart);
		}
	}

  #shop;
	#button;
  #controls;

  get url() {
    return this.dataset.url;
  }

  get item() {
    return {
      title: this.dataset.title,
      url: this.dataset.url,
      weight: this.dataset.weight,
      size: this.dataset.size,
      price: this.dataset.price,
      stock: this.dataset.stock || 1,
      count: this.dataset.count || 1,
    };
  }

  get inCart() {
    return this.#shop.getItem(this.item.url)?.count;
  }

  get isInCart() {
    return this.inCart > 0;
  }

	connectedCallback() {
    this.#shop = document.querySelector('shop-keep');
    this.#button = this.querySelector('button');
    this.#controls = this.querySelectorAll('cart-control');

    if (!this.#shop) throw new Error('This shopping cart needs a shop!');
    if (!this.#button) throw new Error('Need a button for adding to cart');

    this.#waitForShop();
	}

	disconnectedCallback() {
		this.#button.removeEventListener("click", this.#AddToCart);
    document.removeEventListener('cartChange', (e) => this.#SetItemState());
	}

	// private methods
  #waitForShop = async () => {
    await customElements.whenDefined(this.#shop.localName);

    this.#button.addEventListener("click", (e) => this.#AddToCart());
    document.addEventListener('cartChange', (e) => this.#SetItemState());

    this.#SetItemState();
  }

	#AddToCart = () => {
    if (this.isInCart) {
      this.#shop.removeItem(this.url);
      return;
    }

    this.#shop.setItem(this.item);
	}

  #SetItemState = () => {
    this.#button.setAttribute('aria-pressed', this.isInCart);
    this.#controls.forEach((control) => {
      if (control.matches(':focus')) return;
      control.toggleAttribute('hidden', !this.isInCart);
    });
	}
}

AddToCart.register();
</script>
